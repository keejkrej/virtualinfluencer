# Local SQLite (default). Vercel serverless cannot persist this file —
# use Neon Postgres in production. See README → Deploy.
DATABASE_URL="file:./data/dev.db"

# OpenRouter — required for image generation and caption drafting
OPENROUTER_API_KEY=""
OPENROUTER_TEXT_MODEL="openai/gpt-4.1-mini"
OPENROUTER_IMAGE_MODEL="google/gemini-3.1-flash-image-preview"

# Optional Vercel AI Gateway (used if OPENROUTER_API_KEY is empty)
# AI_GATEWAY_API_KEY=""

# Vercel Blob — production asset storage. If unset, files go to data/assets (local only).
BLOB_READ_WRITE_TOKEN=""

# App URL used in OpenRouter attribution headers
APP_URL="http://localhost:3000"

# --- X / Twitter (live adapter when user credentials are present) ---
# OAuth 1.0a user context (required to post tweets + media)
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_SECRET=""
# Optional OAuth 2.0 user access token (text posts)
X_OAUTH2_ACCESS_TOKEN=""

# --- Xiaohongshu / 小红书 (stub) ---
# Official open platform: https://open.xiaohongshu.com
# Typical flow: OAuth 2.0 app → user authorize → note publish API
XHS_APP_KEY=""
XHS_APP_SECRET=""

# --- TikTok (stub) ---
# Content Posting API: https://developers.tiktok.com/doc/content-posting-api-get-started
# OAuth 2.0 with video.upload / video.publish scopes
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# --- Bilibili (stub) ---
# Open platform: https://openhome.bilibili.com
# App key + secret, then OAuth for upload / live
BILIBILI_APP_KEY=""
BILIBILI_APP_SECRET=""
